{
    "include": ["source", "scripts"],
    "exclude": [
        "**/__pycache__",
        "**/_isaac_sim",
        "**/docs",
        "**/logs",
        ".git",
        ".vscode",
    ],
    "venvPath": "/home/kist/anaconda3/envs",
    "venv": "env_isaac",
    "extraPaths": [
        "source/kirack",
        "../IsaacLab/source/isaaclab",
        "../IsaacLab/source/isaaclab_assets",
        "../IsaacLab/source/isaaclab_tasks",
        "../IsaacLab/source/isaaclab_rl",
        "../IsaacLab/source/isaaclab_mimic",
        "../IsaacLab/source/isaaclab_contrib",
        "../../IsaacSim/_build/linux-x86_64/release/kit/python/lib/python3.11/site-packages",
        "../../IsaacSim/_build/linux-x86_64/release/kit/kernel/py",
    ],
    "typeCheckingMode": "basic",
    "pythonVersion": "3.11",
    "pythonPlatform": "Linux",
    "enableTypeIgnoreComments": true,
    "reportMissingImports": "none",
    "reportMissingModuleSource": "none",
    "reportGeneralTypeIssues": "none",
    "reportOptionalMemberAccess": "warning",
    "reportPrivateUsage": "warning",
}
